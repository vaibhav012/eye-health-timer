{
  "manifest_version": 3,
  "name": "20-20-20 Eye Rest Timer",
  "version": "1.0.0",
  "description": "Every 20 minutes, rest your eyes for 20 seconds by looking at something 20 feet away.",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "20-20-20 Eye Rest Timer"
  },
  "permissions": ["alarms", "tabs", "scripting", "storage"],
  "host_permissions": ["<all_urls>"]
}
